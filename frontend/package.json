{
  "name": "frontend",
  "version": "0.1.4",
  "private": true,
  "author": "Allan De Castro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allandecastro/dataverse-ai-forge.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "electron electron/main.cjs",
    "electron:start": "ELECTRON_MODE=start electron electron/main.cjs",
    "publish:backend:win": "dotnet publish ../backend/src/DataverseForge.Api/DataverseForge.Api.csproj -c Release -r win-x64 --self-contained true -o electron/resources/backend",
    "publish:backend:mac": "dotnet publish ../backend/src/DataverseForge.Api/DataverseForge.Api.csproj -c Release -r osx-arm64 --self-contained true -o electron/resources/backend",
    "dist:win": "npm run publish:backend:win && next build && electron-builder --win --publish never",
    "dist:mac": "npm run publish:backend:mac && next build && electron-builder --mac --publish never",
    "release:win": "npm run publish:backend:win && next build && electron-builder --win --publish always",
    "release:mac": "npm run publish:backend:mac && next build && electron-builder --mac --publish always",
    "pack": "npm run publish:backend:mac && next build && electron-builder --dir --publish never",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "electron-updater": "^6.8.9",
    "geist": "^1.7.0",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.16.1",
    "next": "^16.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.5",
    "electron": "^42.11.10",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": "^8.0.16",
    "tar": "^7.5.16",
    "@emnapi/runtime": "^1.11.3",
    "@emnapi/core": "^1.11.3"
  },
  "build": {
    "appId": "com.dataverseaiforge.app",
    "productName": "Dataverse AI Forge",
    "publish": {
      "provider": "github",
      "owner": "allandecastro",
      "repo": "dataverse-ai-forge"
    },
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "!electron/resources/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      },
      {
        "from": "electron/resources/backend",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
