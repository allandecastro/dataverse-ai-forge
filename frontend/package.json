{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "author": "Allan De Castro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/allandecastro/dataverse-ai-forge.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "electron electron/main.cjs",
    "electron:start": "ELECTRON_MODE=start electron electron/main.cjs",
    "dist:win": "next build && electron-builder --win --publish never",
    "pack": "next build && electron-builder --dir --publish never",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "geist": "^1.7.0",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.16.1",
    "next": "^16.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.5",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "vite": "^8.0.16",
    "tar": "^7.5.16"
  },
  "build": {
    "appId": "com.dataverseaiforge.app",
    "productName": "Dataverse AI Forge",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
