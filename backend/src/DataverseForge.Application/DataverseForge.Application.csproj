<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataverseForge.Domain\DataverseForge.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataverseForge.Application.Tests" />
  </ItemGroup>

  <!-- Bundle Dataverse XSD schemas alongside the Application binary so the
       XsdValidator can find them at runtime via AppContext.BaseDirectory.
       Version-pinned in the folder name so a future Dataverse schema bump
       doesn't silently break validation. -->
  <ItemGroup>
    <None Include="..\..\schemas\**\*.xsd" Link="schemas\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Agent system prompts as embedded markdown. Loaded by EmbeddedPrompts.cs;
       each *Prompt.cs is a thin wrapper that pulls its main content from here
       and composes the CommonPromptFragments + ProjectStateTrailer around it.
       Real markdown in version control + GitHub/Cursor previews + cleaner diffs. -->
  <ItemGroup>
    <EmbeddedResource Include="Agents/Prompts/*.md" />
  </ItemGroup>

</Project>
