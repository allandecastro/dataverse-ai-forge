# ─── Azure AI Foundry (required) ───
AZURE_AI_ENDPOINT=https://YOUR-PROJECT.services.ai.azure.com/
AZURE_AI_API_KEY=your-api-key
AZURE_AI_DEFAULT_MODEL=gpt-4o

# ─── Dataverse (required) ───
DATAVERSE_ENVIRONMENT_URL=https://YOUR-ORG.crm.dynamics.com
DATAVERSE_TENANT_ID=your-tenant-id
DATAVERSE_CLIENT_ID=your-client-id
DATAVERSE_CLIENT_SECRET=your-client-secret

# ─── Optional: override the writable data dir (solution exports + user-settings.json) ───
# Default is <bin>/data alongside the binary. Set this when you want artifacts
# to live somewhere stable across rebuilds (e.g. ~/.dvforge or a mounted volume).
# DVFORGE_DATA_DIR=
